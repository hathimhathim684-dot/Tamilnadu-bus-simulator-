<!DOCTYPE html>
<html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1.0">
<title>Bus Simulator Tamil Nadu - Speed 180 Turbo - 3 Friends Gaming</title>
<style>*{margin:0;padding:0;box-sizing:border-box;font-family:Segoe UI,sans-serif}body{background:#0a0a0a;color:#fff;overflow:hidden;touch-action:none}
#gameCanvas{position:absolute;top:0;left:0;width:100%;height:100%}#ui{position:absolute;top:0;left:0;width:100%;height:100%;pointer-events:none;z-index:10}
.top-bar{display:flex;justify-content:space-between;padding:10px;background:rgba(0,0,0,0.7);pointer-events:auto}
.logo{font-weight:900;color:#FFD700}.speed-box{font-size:28px;font-weight:900;color:#00FF88;text-align:center}.speed-box.turbo{color:#FF4500;text-shadow:0 0 20px #FF4500;animation:shake .1s infinite}
@keyframes shake{0%{transform:translateX(-50%)}50%{transform:translateX(-48%)}100%{transform:translateX(-50%)}}
.flame{display:none;position:absolute;bottom:20%;left:50%;transform:translateX(-50%);font-size:24px;background:rgba(255,69,0,0.9);padding:10px 20px;border-radius:20px;font-weight:900}.flame.on{display:block;animation:fire .2s infinite}
@keyframes fire{0%{transform:translateX(-50%) scale(1)}100%{transform:translateX(-50%) scale(1.2)}}
.controls{position:absolute;bottom:10px;left:0;width:100%;display:flex;justify-content:space-between;padding:10px;pointer-events:auto}
.btn{background:rgba(255,255,255,0.15);border:2px solid rgba(255,255,255,0.3);color:#fff;padding:15px 20px;border-radius:15px;font-weight:800;backdrop-filter:blur(10px);user-select:none}
.btn:active{background:rgba(255,255,255,0.4);transform:scale(.95)}.btn.turbo-btn{background:linear-gradient(45deg,#FF4500,#FFD700);border-color:#FF4500;color:#000;font-size:18px;box-shadow:0 0 20px #FF4500}
.district-bar{position:absolute;top:60px;left:50%;transform:translateX(-50%);background:rgba(0,0,0,0.8);padding:8px 20px;border-radius:20px;font-size:14px;pointer-events:auto}
.menu{position:absolute;top:0;left:0;width:100%;height:100%;background:linear-gradient(135deg,#0f0f0f,#1a1a2e);display:flex;flex-direction:column;align-items:center;justify-content:center;z-index:20}
.menu h1{font-size:32px;color:#FFD700;text-align:center;margin-bottom:10px}.play-btn{background:linear-gradient(45deg,#00FF88,#00CC6A);color:#000;padding:20px 60px;border:none;border-radius:30px;font-size:22px;font-weight:900;cursor:pointer}</style></head>
<body>
<div class="menu" id="menu"><h1>🚌 BUS SIMULATOR<br>TAMIL NADU<br><span style="color:#FF4500">SPEED 180 TURBO</span></h1>
<p>38 Districts | Nellikuppam Main | 4K Bus Stands<br>5 Real TN Buses | Google Maps | 20 Old Items + New</p><p style="color:#FFD700;font-weight:800">By 3 Friends Gaming - Nellikuppam</p>
<button class="play-btn" onclick="startGame()">▶️ PLAY NOW - 180 KM/H</button>
<p style="margin-top:20px;font-size:12px;color:#666">V13 Final - Old + New + 180 Turbo</p></div>
<canvas id="gameCanvas"></canvas>
<div id="ui"><div class="top-bar"><div class="logo">3 FRIENDS GAMING<br><span style="font-size:10px;color:#fff">NELLAIKUPPAM</span></div><div style="text-align:right"><div style="font-size:12px">38 DISTRICTS</div><div style="color:#FFD700;font-size:12px">4K + MAPS</div></div></div>
<div class="district-bar" id="districtBar">📍 Nellikuppam Bus Stand - Main - Platform 1</div>
<div class="speed-box" id="speedBox" style="position:absolute;top:100px;left:50%;transform:translateX(-50%);background:rgba(0,0,0,0.8);padding:10px 30px;border-radius:20px">0 KM/H</div>
<div class="flame" id="flame">🔥🔥 TURBO 180 🔥🔥</div>
<div class="controls"><div style="display:flex;gap:10px"><div class="btn" id="brakeBtn">⏸️ BRAKE</div><div class="btn" id="leftBtn">⬅️</div><div class="btn" id="rightBtn">➡️</div></div>
<div style="display:flex;gap:10px"><div class="btn turbo-btn" id="turboBtn">⚡ TURBO 180</div><div class="btn" id="goBtn" style="background:#00FF88;color:#000">GO 🚀</div></div></div>
</div>
<script>
const canvas=document.getElementById('gameCanvas'),ctx=canvas.getContext('2d');let W,H;function resize(){W=canvas.width=window.innerWidth;H=canvas.height=window.innerHeight}window.addEventListener('resize',resize);resize();
let speed=0,targetSpeed=0,turbo=false,playing=false,distance=0,districtIndex=0;
const districts=["Nellikuppam Main","Cuddalore","Villupuram","Kallakurichi","Tiruvannamalai","Salem","Trichy","Thanjavur","Madurai","Tirunelveli","Kanyakumari","Chennai","Coimbatore","Erode","Karur","Dindigul","Theni","Virudhunagar","Ramanathapuram","Pudukkottai","Sivaganga","Tenkasi","Thoothukudi","Nagapattinam","Tiruvarur","Mayiladuthurai","Ariyalur","Perambalur","Namakkal","Dharmapuri","Krishnagiri","Vellore","Ranipet","Tirupathur","Chengalpattu","Tiruvallur","Kanchipuram","Nilgiris"];
let roadOffset=0;
function startGame(){document.getElementById('menu').style.display='none';playing=true;loop();}
function loop(){if(!playing)return;roadOffset+=speed*0.5;distance+=speed*0.01;if(distance>200){distance=0;districtIndex=(districtIndex+1)%districts.length;document.getElementById('districtBar').innerText=`📍 ${districts[districtIndex]} Bus Stand - Platform ${Math.floor(Math.random()*4)+1}`;}
if(turbo){targetSpeed=180}else{targetSpeed=70}speed+=(targetSpeed-speed)*0.05;if(speed<1)speed=0;
ctx.clearRect(0,0,W,H);let skyGrad=ctx.createLinearGradient(0,0,0,H*0.6);skyGrad.addColorStop(0,'#1a3a6f');skyGrad.addColorStop(1,'#87CEEB');ctx.fillStyle=skyGrad;ctx.fillRect(0,0,W,H*0.6);
ctx.fillStyle='#2a2a2a';ctx.fillRect(0,H*0.6,W,H*0.4);ctx.fillStyle='#555';ctx.fillRect(W*0.1,H*0.6,W*0.8,H*0.4);ctx.fillStyle='#FFD700';for(let i=-100;i<W+100;i+=80){ctx.fillRect(W/2-5+i+(roadOffset%80),H*0.62,10,30);}
ctx.fillStyle='#1a5a1a';ctx.fillRect(0,H*0.6,W*0.1,H*0.4);ctx.fillRect(W*0.9,H*0.6,W*0.1,H*0.4);ctx.fillStyle='rgba(0,0,0,0.3)';ctx.fillRect(W/2-60,H*0.75,120,20);
ctx.fillStyle=turbo?'#FF4500':'#FFD700';ctx.fillRect(W/2-50,H*0.65,100,50);ctx.fillStyle='#000';ctx.fillRect(W/2-50,H*0.65,100,8);ctx.fillStyle='#87CEEB';ctx.fillRect(W/2+20,H*0.68,25,15);
ctx.fillStyle='#222';ctx.beginPath();ctx.arc(W/2-25,H*0.82,12,0,Math.PI*2);ctx.fill();ctx.beginPath();ctx.arc(W/2+25,H*0.82,12,0,Math.PI*2);ctx.fill();
let standScale=Math.max(0.3,1-distance/300);if(standScale>0.3){ctx.fillStyle='#444';ctx.fillRect(W/2-100*standScale,H*0.55,200*standScale,60*standScale);ctx.fillStyle='#FFD700';ctx.font=`${12*standScale}px Arial`;ctx.fillText(districts[districtIndex],W/2-40*standScale,H*0.58);}
const box=document.getElementById('speedBox');box.innerText=Math.floor(speed)+' KM/H';if(speed>160){box.classList.add('turbo');document.getElementById('flame').classList.add('on')}else{box.classList.remove('turbo');document.getElementById('flame').classList.remove('on')}
requestAnimationFrame(loop);}
document.getElementById('goBtn').addEventListener('touchstart',(e)=>{e.preventDefault();targetSpeed=turbo?180:80});document.getElementById('goBtn').addEventListener('mousedown',()=>{targetSpeed=turbo?180:80});
document.getElementById('brakeBtn').addEventListener('touchstart',(e)=>{e.preventDefault();targetSpeed=0;turbo=false});document.getElementById('brakeBtn').addEventListener('mousedown',()=>{targetSpeed=0;turbo=false});
document.getElementById('turboBtn').addEventListener('click',()=>{turbo=!turbo;document.getElementById('turboBtn').style.background=turbo?'#00FF88':'linear-gradient(45deg,#FF4500,#FFD700)';});
let lastTap=0;document.getElementById('goBtn').addEventListener('touchend',()=>{let now=Date.now();if(now-lastTap<300){turbo=true;targetSpeed=180}lastTap=now;});
</script></body></html>
